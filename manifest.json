{
  "manifest_version": 3,
  "name": "Jar-Jar Binksify",
  "version": "1.0",

  "description": "Jar-Jar Binksify your web-browsing experience!",

  "browser_specific_settings": {
    "gecko": {
      "id": "jarjarbinksify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["binksify.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["replacement-text.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
