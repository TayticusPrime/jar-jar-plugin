{
  "manifest_version": 3,
  "name": "Jar-Jar Binksify",
  "version": "1.0",

  "description": "Jar-Jar Binksify your web-browsing experience!",

  "browser_specific_settings": {
    "gecko": {
      "id": "jarjarbinksify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["tabs"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "scripts": ["scheduler.js"]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "config/config.json",
        "config/replacement-text.json",
        "assets/audio/manifest.json",
        "assets/audio/*.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
