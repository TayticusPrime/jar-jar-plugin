{
  "manifest_version": 3,
  "name": "Jar-Jar Binksify",
  "version": "1.0",

  "description": "Jar-Jar Binksify your web-browsing experience!",

  "browser_specific_settings": {
    "gecko": {
      "id": "jarjarbinksify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "node_modules/webextension-polyfill/dist/browser-polyfill.js",
        "main.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "config/config.json",
        "config/replacement-text.json",
        "assets/images/manifest.json",
        "assets/images/*",
        "assets/overlays/manifest.json",
        "assets/overlays/*",
        "assets/audio/manifest.json",
        "assets/audio/*.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
